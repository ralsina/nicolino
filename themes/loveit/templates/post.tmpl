{#-
  post.tmpl - LoveIt theme single post

  Mirrors LoveIt's posts/single.html: big single-title, a post-meta
  block with two meta lines (fallback marker; calendar icon + date,
  pencil icon + word count, clock icon + reading time), the
  collapsible Contents box, content, and LoveIt's post footer
  (Updated on, tags, Back | Home).

  NOTE: rendered with only the post value at runtime — do not
  reference `theme.*` here (see porting guide).

  Variables: breadcrumbs, title, link, date, metadata, taxonomies,
  toc, html, word_count, reading_time, related_posts, is_fallback
-#}
{% include "templates/title.tmpl" %}

<article class="page single">
  <h1 class="single-title">{{ title }}</h1>
  <div class="post-meta">
    {% if is_fallback %}
    <div class="post-meta-line">
      <span class="fallback-marker" title="No translation available for this language">🌐 untranslated</span>
    </div>
    {% endif %}
    <div class="post-meta-line">
      {% if date %}
      <span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <time>{{ date }}</time>
      </span>
      {% endif %}
      <span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><line x1="2" y1="2" x2="9.586" y2="9.586"></line><circle cx="11" cy="11" r="2"></circle></svg>
        {% if word_count == 1 %}One word{% else %}{{ word_count }} words{% endif %}
      </span>
      <span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        {% if reading_time == 1 %}One minute{% else %}{{ reading_time }} minutes{% endif %}
      </span>
      {% if metadata.updated and show_updated %}
      <span>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        Updated on {{ metadata.updated }}
      </span>
      {% endif %}
    </div>
  </div>

  {% if toc and toc|length > 0 %}
  <details class="details toc toc-static" id="toc-static" open>
    <summary class="details-summary toc-title">
      <span>Contents</span>
    </summary>
    <div class="details-content toc-content">
      {{ toc|safe }}
    </div>
  </details>
  {% endif %}

  <div class="content" id="content">
    {{ html|safe }}
  </div>

  <footer class="post-footer" id="post-footer">
    <div class="post-info">
      {% if taxonomies|length > 0 %}
      <div class="post-info-more">
        <section class="post-tags">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
          {% for taxonomy, terms in taxonomies %}
            {% for term in terms %}
            <a href="{{ term.link }}">{{ term.name }}</a>{% if not loop.last %},&nbsp;{% endif %}
            {% endfor %}
          {% endfor %}
        </section>
        <section>
          <span><a href="#" onclick="window.history.back(); return false;">Back</a></span>&nbsp;|&nbsp;<span><a href="/">Home</a></span>
        </section>
      </div>
      {% endif %}
    </div>
  </footer>

  {% if related_posts and related_posts|length > 0 %}
  <section class="related-posts">
    <h2>Related</h2>
    <ul>
      {% for related in related_posts %}
      <li><a href="{{ related.link }}">{{ related.title }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</article>
