{#- listings-index.tmpl - LoveIt theme code listings index
    Variables: listings [{title, link}] -#}
<header class="page-header">
  <h1>Code Listings</h1>
</header>
<ul class="archive-list">
  {% for item in listings %}
  <li class="archive-item">
    <a class="archive-item-link" href="{{ item.link }}">{{ item.title }}</a>
  </li>
  {% endfor %}
</ul>
