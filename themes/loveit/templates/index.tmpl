{#-
  index.tmpl - LoveIt theme post list

  Mirrors LoveIt's summary partial: optional featured image (30%
  aspect ratio, cover), h1 single-title, post-meta (author icon +
  "published on"), 3-line-clamped excerpt and a post-footer with
  "Read More" left and comma-separated tags right, each summary
  separated by a dashed rule.

  Variables:
  - posts: Array of post values (link, title, date, summary,
    preview_image, taxonomies, has_teaser)
  - has_more: Whether older posts exist in the archive
-#}
<div class="home-posts">
  {% for post in posts %}
  <article class="single summary">
    {% if post.preview_image %}
    <div class="featured-image-preview">
      <a href="{{ post.link }}">
        <img src="{{ post.preview_image }}" alt="{{ post.title }}" loading="lazy" />
      </a>
    </div>
    {% endif %}
    <h1 class="single-title"><a href="{{ post.link }}">{{ post.title }}</a></h1>
    <div class="post-meta">
      {% if (theme.author|default('')) != '' %}
      <span class="post-author">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        {{ theme.author }}
      </span>
      {% endif %}
      {% if post.date %}
      <span class="post-publish">
        published on <time>{{ post.date }}</time>
      </span>
      {% endif %}
    </div>
    {% if not theme.hide_summary %}
    <div class="content">
      {{ post.summary|striptags }}{% if post.has_teaser %}…{% endif %}
    </div>
    {% endif %}
    <div class="post-footer">
      <a href="{{ post.link }}">{{ theme.read_more | default("Read More") }}</a>
      {% if post.taxonomies|length > 0 %}
      <div class="post-tags">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
        {% for taxonomy, terms in post.taxonomies %}
          {% for term in terms %}
          <a href="{{ term.link }}">{{ term.name }}</a>{% if not loop.last %},&nbsp;{% endif %}
          {% endfor %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </article>
  {% endfor %}
</div>

{% if has_more %}
<nav class="pagination">
  <a class="prev" href="/archive/">Older posts</a>
</nav>
{% endif %}
