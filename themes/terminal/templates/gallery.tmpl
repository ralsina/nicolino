{#- gallery.tmpl - Terminal theme gallery page
    Variables: breadcrumbs, title, link, html, image_list -#}
{% include "templates/title.tmpl" %}

<div class="post-content">
  {{ html|safe }}
  <div class="gallery">
    {% for image in image_list %}
    <div class="gallery-item">
      {% if image.is_video %}
      <video class="gallery-video" controls preload="metadata" src="{{ image.name }}"></video>
      {% else %}
      <a href="{{ image.name }}">
        <img src="{{ image.name | thumb_url }}" alt="{{ image.name }}" loading="lazy" />
      </a>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
<style>
.gallery { display: flex; flex-wrap: wrap; gap: 1rem; }
.gallery-item img { max-width: 100%; height: auto; }
</style>
