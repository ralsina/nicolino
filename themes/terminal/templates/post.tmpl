{#-
  post.tmpl - Terminal theme single post

  Variables: breadcrumbs, title, link, date, metadata, taxonomies,
  toc, html, related_posts, is_fallback (see Nicolino docs)
-#}
{% include "templates/title.tmpl" %}

<article class="post">
  <h1 class="post-title"><a href="{{ link }}">{{ title }}</a></h1>
  <div class="post-meta">
    {% if date %}
    <time class="post-date">{{ date }}</time>
    {% endif %}
    {% if metadata.updated and show_updated %}
    <span class="post-updated">(updated: {{ metadata.updated }})</span>
    {% endif %}
  </div>

  {% if taxonomies|length > 0 %}
  <span class="post-tags">
    {% for taxonomy, terms in taxonomies %}
      {% for term in terms %}
      #<a href="{{ term.link }}">{{ term.name }}</a>&nbsp;
      {% endfor %}
    {% endfor %}
  </span>
  {% endif %}

  {% if is_fallback %}
  <p class="post-fallback-notice">⚠ This page has not been translated yet.</p>
  {% endif %}

  {% if toc and toc|length > 0 %}
  <div class="table-of-contents">
    <h2>Table of Contents</h2>
    {{ toc|safe }}
  </div>
  {% endif %}

  <div class="post-content">
    {{ html|safe }}
  </div>

  {% if related_posts and related_posts|length > 0 %}
  <div class="related-posts">
    <h2>Related</h2>
    <ul>
      {% for related in related_posts %}
      <li><a href="{{ related.link }}">{{ related.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</article>
