{#- gallery_cards.tmpl - Terminal theme gallery card grid
    Variables: title, description, items [{link, title, thumb_link}] -#}
<section class="gallery-cards">
  {% if description %}
  <p class="index-content">{{ description }}</p>
  {% endif %}
  <div class="cards-grid">
    {% for item in items %}
    <div class="card-item">
      <a href="{{ item.link }}">
        <img src="{{ item.thumb_link }}" alt="{{ item.title }}" loading="lazy" />
        <span>{{ item.title }}</span>
      </a>
    </div>
    {% endfor %}
  </div>
</section>
<style>
.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
.card-item img { width: 100%; height: auto; }
.card-item a { text-decoration: none; color: var(--accent); }
</style>
