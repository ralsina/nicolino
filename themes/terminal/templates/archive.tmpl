{#- archive.tmpl - Terminal theme chronological archive -#}
<div class="archive">
  <h1 class="post-title">Archive</h1>
  {% for year in years %}
  <details {% if year.year == latest_year %}open{% endif %}>
    <summary role="button" style="cursor: pointer;">{{ year.year }}</summary>
    {% for month in year.months %}
    <div class="archive-month">
      <h3>{{ month.name }}</h3>
      <ul>
        {% for post in month.posts %}
        <li><a href="{{ post.link }}">{{ post.title }}</a> <small>{{ post.date }}</small></li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </details>
  {% endfor %}
</div>
