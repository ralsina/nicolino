{#- archive.tmpl - PaperMod yearly archive -#}
<div class="archive">
  <header class="page-header">
    <h1>Archive</h1>
  </header>
  {% for year in years %}
  <h2 class="archive-year">{{ year.year }}</h2>
  <ul class="archive-months">
    {% for month in year.months %}
    <li class="archive-month">
      <h3>{{ month.name }}</h3>
      <ul>
        {% for post in month.posts %}
        <li>
          <a href="{{ post.link }}">{{ post.title }}</a>
          <span class="archive-date">{{ post.date }}</span>
        </li>
        {% endfor %}
      </ul>
    </li>
    {% endfor %}
  </ul>
  {% endfor %}
</div>
<style>
.archive-year { margin: 2rem 0 0.5rem; }
.archive-months { list-style: none; padding-left: 0; }
.archive-month h3 { margin: 1rem 0 0.25rem; color: var(--secondary); }
.archive-month ul { list-style: none; padding-left: 0.5rem; }
.archive-month li { padding: 2px 0; }
.archive-date { color: var(--secondary); font-size: 0.85em; margin-left: 6px; }
</style>
