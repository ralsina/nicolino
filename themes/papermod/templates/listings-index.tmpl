{#- listings-index.tmpl - PaperMod code listings index
    Variables: listings [{title, link}] -#}
<header class="page-header">
  <h1>Code Listings</h1>
</header>
<div class="post-content">
  <ul>
    {% for item in listings %}
    <li><a href="{{ item.link }}">{{ item.title }}</a></li>
    {% endfor %}
  </ul>
</div>
