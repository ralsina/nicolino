{#- gallery_cards.tmpl - PaperMod gallery card grid
    Variables: title, description, items [{link, title, thumb_link}] -#}
{% if description %}
<div class="post-content"><p>{{ description }}</p></div>
{% endif %}
<div class="papermod-gallery">
  {% for item in items %}
  <div class="papermod-gallery-item">
    <a href="{{ item.link }}">
      <img src="{{ item.thumb_link }}" alt="{{ item.title }}" loading="lazy" />
    </a>
  </div>
  {% endfor %}
</div>
<style>
.papermod-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--gap); padding: var(--gap) 0; }
.papermod-gallery-item { background: var(--entry); border-radius: var(--radius); overflow: hidden; }
.papermod-gallery-item img { width: 100%; height: auto; display: block; }
</style>
